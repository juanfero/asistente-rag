                    },
                    "503": {
                        "description": "Service Unavailable",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorOut"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/documents/{source}": {
            "delete": {
                "tags": [
                    "documentos"
                ],
                "summary": "Delete Document",
                "description": "Quita un documento del índice; con ?delete_file=true borra también el archivo, solo si\nes una subida (los del corpus son protegidos → 403).",
                "operationId": "delete_document_documents__source__delete",
                "parameters": [
                    {
                        "name": "source",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Source"
                        }
                    },
                    {
                        "name": "delete_file",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "default": false,
                            "title": "Delete File"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DeleteOut"
                                }
                            }
                        }
                    },
                    "400": {
