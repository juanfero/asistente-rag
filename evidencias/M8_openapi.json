{
    "openapi": "3.1.0",
    "info": {
        "title": "Asistente documental RAG",
        "description": "Responde preguntas solo con los documentos internos, citando las fuentes.",
        "version": "1.0.0"
    },
    "paths": {
        "/health": {
            "get": {
                "tags": [
                    "estado"
                ],
                "summary": "Health",
                "description": "Estado del servicio, modelos configurados y tamaño del índice (no llama a Gemini).",
                "operationId": "health_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthOut"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/documents": {
            "get": {
                "tags": [
                    "documentos"
                ],
                "summary": "List Documents",
                "description": "Fuentes indexadas con su nº de chunks y su origen (corpus o subida).",
                "operationId": "list_documents_documents_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "items": {
                                        "$ref": "#/components/schemas/DocumentOut"
                                    },
                                    "type": "array",
                                    "title": "Response List Documents Documents Get"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "documentos"
                ],
                "summary": "Upload Documents",
                "description": "Sube 1..n archivos a data/uploads/ y los ingiere (una subida previa con el mismo nombre\nse reemplaza; un nombre del corpus devuelve 409).",
