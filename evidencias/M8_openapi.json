    "components": {
        "schemas": {
            "AskRequest": {
                "properties": {
                    "question": {
                        "type": "string",
                        "maxLength": 1000,
                        "minLength": 1,
                        "title": "Question"
                    },
                    "top_k": {
                        "anyOf": [
                            {
                                "type": "integer",
                                "maximum": 20.0,
                                "minimum": 1.0
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Top K"
                    }
                },
                "type": "object",
                "required": [
                    "question"
                ],
                "title": "AskRequest",
                "description": "Pregunta (1–1.000 caracteres, sin contar espacios extremos) y top_k opcional."
            },
            "AskResponse": {
                "properties": {
                    "question": {
                        "type": "string",
                        "title": "Question"
                    },
                    "answer": {
                        "type": "string",
                        "title": "Answer"
                    },
                    "grounded": {
                        "type": "boolean",
                        "title": "Grounded"
                    },
                    "sources": {
                        "items": {
                            "$ref": "#/components/schemas/SourceOut"
                        },
                        "type": "array",
                        "title": "Sources"
                    },
                    "context": {
                        "items": {
                            "$ref": "#/components/schemas/SourceOut"
                        },
                        "type": "array",
                        "title": "Context"
                    },
                    "model": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Model"
                    },
                    "latency_s": {
                        "type": "number",
                        "title": "Latency S"
                    },
                    "retrieved": {
                        "type": "integer",
                        "title": "Retrieved"
                    },
                    "llm_called": {
                        "type": "boolean",
                        "title": "Llm Called"
                    }
                },
                "type": "object",
                "required": [
                    "question",
                    "answer",
                    "grounded",
                    "sources",
                    "context",
                    "model",
                    "latency_s",
                    "retrieved",
                    "llm_called"
                ],
                "title": "AskResponse",
                "description": "Respuesta del motor RAG."
            },
            "Body_upload_documents_documents_post": {
                "properties": {
                    "files": {
                        "items": {
                            "type": "string",
                            "contentMediaType": "application/octet-stream"
                        },
                        "type": "array",
                        "title": "Files",
                        "description": "Archivos .txt, .md o .pdf (≤ 10 MB cada uno)"
                    }
                },
                "type": "object",
                "required": [
                    "files"
                ],
                "title": "Body_upload_documents_documents_post"
            },
            "DeleteOut": {
                "properties": {
                    "source": {
                        "type": "string",
                        "title": "Source"
                    },
                    "deleted_chunks": {
                        "type": "integer",
                        "title": "Deleted Chunks"
                    },
                    "file_deleted": {
                        "type": "boolean",
                        "title": "File Deleted"
                    }
                },
                "type": "object",
                "required": [
                    "source",
                    "deleted_chunks",
                    "file_deleted"
                ],
                "title": "DeleteOut",
                "description": "Resultado de eliminar un documento."
            },
            "DocumentOut": {
                "properties": {
                    "source": {
                        "type": "string",
                        "title": "Source"
                    },
                    "chunks": {
                        "type": "integer",
                        "title": "Chunks"
                    },
                    "origin": {
                        "type": "string",
                        "enum": [
                            "corpus",
                            "upload",
                            "desconocido"
                        ],
                        "title": "Origin"
                    }
                },
                "type": "object",
                "required": [
                    "source",
                    "chunks",
                    "origin"
                ],
                "title": "DocumentOut",
                "description": "Fuente indexada con su nº de chunks y su origen."
            },
            "ErrorOut": {
                "properties": {
                    "error": {
                        "type": "string",
                        "title": "Error"
                    },
                    "detail": {
                        "type": "string",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "required": [
                    "error",
                    "detail"
                ],
                "title": "ErrorOut",
                "description": "Formato único de error."
            },
            "HealthOut": {
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "ok",
                            "index_model_mismatch"
                        ],
                        "title": "Status"
                    },
                    "llm_model": {
                        "type": "string",
                        "title": "Llm Model"
                    },
                    "llm_configured": {
                        "type": "boolean",
                        "title": "Llm Configured"
                    },
                    "embedding_model": {
                        "type": "string",
                        "title": "Embedding Model"
                    },
                    "chunks": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Chunks"
                    },
                    "documents": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Documents"
                    },
                    "min_score": {
                        "type": "number",
                        "title": "Min Score"
                    },
                    "top_k": {
                        "type": "integer",
                        "title": "Top K"
                    }
                },
                "type": "object",
                "required": [
                    "status",
                    "llm_model",
                    "llm_configured",
                    "embedding_model",
                    "chunks",
                    "documents",
                    "min_score",
                    "top_k"
                ],
                "title": "HealthOut",
                "description": "Estado del servicio (no llama a Gemini)."
            },
            "IngestReportOut": {
                "properties": {
                    "files_processed": {
                        "type": "integer",
                        "title": "Files Processed"
                    },
                    "files_skipped": {
                        "type": "integer",
                        "title": "Files Skipped"
                    },
                    "documents": {
                        "type": "integer",
                        "title": "Documents"
                    },
                    "chunks_added": {
                        "type": "integer",
                        "title": "Chunks Added"
                    },
                    "total_in_store": {
                        "type": "integer",
                        "title": "Total In Store"
                    },
                    "sources": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Sources"
                    },
                    "skipped": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Skipped"
                    },
                    "duration_s": {
                        "type": "number",
                        "title": "Duration S"
                    }
                },
                "type": "object",
                "required": [
                    "files_processed",
                    "files_skipped",
                    "documents",
                    "chunks_added",
                    "total_in_store",
                    "sources",
                    "skipped",
                    "duration_s"
                ],
                "title": "IngestReportOut",
                "description": "Reporte de ingesta."
            },
            "IngestRequest": {
                "properties": {
                    "reset": {
                        "type": "boolean",
                        "title": "Reset",
                        "default": false
                    }
                },
                "type": "object",
                "title": "IngestRequest",
                "description": "Opciones de re-ingesta."
            },
            "SourceOut": {
                "properties": {
                    "source": {
                        "type": "string",
                        "title": "Source"
                    },
                    "page": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Page"
                    },
                    "chunk_id": {
                        "type": "string",
                        "title": "Chunk Id"
                    },
                    "score": {
                        "type": "number",
                        "title": "Score"
                    },
                    "excerpt": {
                        "type": "string",
                        "title": "Excerpt"
                    },
                    "cited": {
                        "type": "boolean",
                        "title": "Cited"
                    },
                    "index": {
                        "type": "integer",
                        "title": "Index"
                    }
                },
                "type": "object",
                "required": [
                    "source",
                    "page",
                    "chunk_id",
                    "score",
                    "excerpt",
                    "cited",
                    "index"
                ],
                "title": "SourceOut",
                "description": "Fragmento usado como contexto, con su número [n] en el prompt."
            }
        }
    }
}
