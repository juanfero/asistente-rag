# Copiar a .env y completar. Nunca commitear .env.

# --- LLM: Gemini (endpoint compatible con OpenAI, ADR-010) ---
# La key va SOLO en .env (ignorado por git). Este archivo debe quedar con el valor vacío.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Prefijos de e5 (solo al codificar). Con espacio final, usar comillas. Vacíos = sin prefijo
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "

# --- Datos y vector store ---
DOCS_DIR=data/docs
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=documentos

# --- Chunking y recuperación ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
# Filtro de ruido calibrado en M7 (ADR-005); la abstención la decide el LLM
MIN_SCORE=0.805

# --- Interfaces ---
API_URL=http://localhost:8000

# --- Logging ---
LOG_LEVEL=INFO
