# Copiar a .env y completar. Nunca commitear .env.

# --- LLM: Gemini (endpoint compatible con OpenAI, ADR-010) ---
# La key va SOLO en .env (ignorado por git). Este archivo debe quedar con el valor vacío.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Prefijos de e5 (solo al codificar). Con espacio final, usar comillas. Vacíos = sin prefijo
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "

# --- Datos y vector store ---
DOCS_DIR=data/docs
UPLOADS_DIR=data/uploads
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=documentos

# --- Interfaces ---
API_URL=http://localhost:8000

# --- Logging ---
LOG_LEVEL=INFO

# --- Parámetros de ajuste (calibrados en el código) ---
# Descomenta solo si quieres sobrescribir el valor calibrado del código.
# Al arrancar, la CLI y la API registran los valores efectivos y avisan (WARNING) si
# MIN_SCORE, CHUNK_SIZE o CHUNK_OVERLAP difieren de los calibrados.
# CHUNK_SIZE=800          # ADR-004 / ADR-009
# CHUNK_OVERLAP=120       # ADR-004 / ADR-009
# TOP_K=4                 # ADR-005
# MIN_SCORE=0.805         # ADR-005: filtro de ruido; la abstención la decide el LLM
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=700
