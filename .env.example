# Copiar a .env y completar. Nunca commitear .env.

# --- LLM: Grok (xAI) ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Datos y vector store ---
DOCS_DIR=data/docs
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=documentos

# --- Chunking y recuperación ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_SCORE=0.35

# --- Interfaces ---
API_URL=http://localhost:8000

# --- Logging ---
LOG_LEVEL=INFO
