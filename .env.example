# Copiar a .env y completar. Nunca commitear .env.

# --- LLM: Grok (xAI) ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Prefijos de e5 (solo al codificar). Con espacio final, usar comillas. Vacíos = sin prefijo
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "

# --- Datos y vector store ---
DOCS_DIR=data/docs
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=documentos

# --- Chunking y recuperación ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
# Provisional: se calibra en M7 (ADR-005)
MIN_SCORE=0.80

# --- Interfaces ---
API_URL=http://localhost:8000

# --- Logging ---
LOG_LEVEL=INFO
